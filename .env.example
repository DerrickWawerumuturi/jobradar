# Postgres (Neon). The pooled -pooler host is PgBouncer in transaction mode and
# is what the application uses at runtime.
DATABASE_URL=postgresql://<user>:<pw>@ep-<id>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Same database without -pooler. Used only by `python -m src.database.migrate`,
# because DDL and CREATE EXTENSION want a real session rather than PgBouncer.
DATABASE_URL_DIRECT=postgresql://<user>:<pw>@ep-<id>.<region>.aws.neon.tech/neondb?sslmode=require

# CORS. The browser calls this API directly (an analysis outlives a serverless
# function), so the dashboard's origin must be listed or the preflight 400s.
ALLOWED_ORIGINS=http://localhost:3000
# Optional, for origins that cannot be enumerated such as Vercel previews.
# Scope it to your own project rather than all of *.vercel.app.
# ALLOWED_ORIGIN_REGEX=https://jobradar-.*\.vercel\.app

# llm
GROQ_API_KEY=
GROQ_MODEL_NAME=

# job search apis
JSEARCH_API_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
MUSE_API_KEY=
# Free key from jooble.org/api/about — 60+ countries, the only provider here
# with real inventory outside the large markets. Disabled while unset.
JOOBLE_API_KEY=

# optional tuning
# JOBRADAR_GROQ_REASONING_EFFORT=medium
# JOBRADAR_GROQ_MAX_COMPLETION_TOKENS=4096
# JOBRADAR_EXTRACTION_WORKERS=4
# Path to en_core_web_lg. Only needed if it is neither at the container path
# nor in the checkout; see docs/architecture/backend.md.
# JOBRADAR_SPACY_MODEL=
# JOBRADAR_EXTRACTOR_VERSION=skillner-emsi-v1
# JOBRADAR_DB_POOL_SIZE=4
